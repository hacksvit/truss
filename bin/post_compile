#!/usr/bin/env bash
set -euo pipefail

# This hook runs at the end of the *Python* buildpack only. If Python is first,
# npm is not on PATH yet; heroku/nodejs will build web/dist afterward.
if ! command -v npm >/dev/null 2>&1; then
  echo "-----> Skipping website build (npm not installed yet)."
  echo "       heroku/nodejs must run after this step, or put Python last:"
  echo "       heroku-community/apt, heroku/nodejs, heroku/python"
  exit 0
fi

# Vite and TypeScript live in web/devDependencies. Heroku sets NODE_ENV=production
# and would otherwise skip them, leaving web/dist empty at dyno boot.
export NPM_CONFIG_PRODUCTION=false
export NODE_ENV=development

echo "-----> Building website into web/dist"
npm --prefix web ci --include=dev
npm --prefix web run build

if [ ! -f web/dist/index.html ]; then
  echo "-----> web/dist/index.html was not produced"
  exit 1
fi
