        "debt_scale_wh": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Debt Scale Wh",
          "type": "number"
        },
        "weight_cap": {
          "maximum": 2,
          "minimum": 2,
          "title": "Weight Cap",
          "type": "number"
        },
        "member_floor_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Member Floor W",
          "type": "integer"
        },
        "member_useful_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Member Useful W",
          "type": "integer"
        },
        "member_debt_wh": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Member Debt Wh",
          "type": "number"
        },
        "member_weight": {
          "maximum": 2,
          "minimum": 1,
          "title": "Member Weight",
          "type": "number"
        },
        "proposed_budget_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Proposed Budget W",
          "type": "integer"
        },
        "issued_budget_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Issued Budget W",
          "type": "integer"
        },
        "reservation_before_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Reservation Before W",
          "type": "integer"
        },
        "reservation_after_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Reservation After W",
          "type": "integer"
        },
        "total_exposure_after_w": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Total Exposure After W",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "initial",
            "renewal",
            "cap_change",
            "capacity_exhausted",
            "baseline_only",
            "stale_offer",
            "policy_conflict",
            "recovery",
            "member_budget_exceeded",
            "min_run",
            "deadline_missed",
            "old_version",
            "wrong_identity",
            "wrong_boot",
            "wrong_request",
            "wrong_registry",
            "expired",
            "duplicate",
            "invalid_amount",
            "enforcer_fault",
            "manual_priority",
