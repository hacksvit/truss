        "policy_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "registry_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Registry Revision",
          "type": "integer"
        },
        "cap_revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Cap Revision",
          "type": "integer"
        },
        "cap_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Cap W",
          "type": "integer"
        },
        "measurement_reserve_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Measurement Reserve W",
          "type": "integer"
        },
        "external_bound_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "External Bound W",
          "type": "integer"
        },
        "baseline_sum_w": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Baseline Sum W",
          "type": "integer"
        },
        "surplus_pool_w": {
          "maximum": 100000,
          "minimum": 0,
