        "requested_w": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Requested W",
          "type": "integer"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "quality": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ],
          "title": "Quality",
          "type": "string"
        },
        "sample_age_ms": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sample Age Ms"
        },
        "ack": {
          "enum": [
            "pending",
            "applied",
            "verified",
            "rejected",
            "stale",
            "none"
          ],
          "title": "Ack",
          "type": "string"
        },
        "protected": {
          "title": "Protected",
          "type": "boolean"
        },
        "control_policy": {
          "enum": [
            "protected",
            "flexible",
            "unclassified"
          ],
