          "type": "string"
        },
        "curtailment_eligible": {
          "title": "Curtailment Eligible",
          "type": "boolean"
        },
        "deadline_in_ms": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
