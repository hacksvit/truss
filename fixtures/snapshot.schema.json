        "policy_hash",
        "registry_revision",
        "cap_revision",
        "cap_w",
        "measurement_reserve_w",
        "external_bound_w",
        "baseline_sum_w",
        "surplus_pool_w",
        "rule",
        "debt_scale_wh",
        "weight_cap",
        "member_floor_w",
