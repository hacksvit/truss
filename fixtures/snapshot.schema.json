          "type": "string"
        },
        "command_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Id"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "w",
        "requested_w",
        "state",
        "quality",
        "sample_age_ms",
        "ack",
        "protected",
        "control_policy",
        "curtailment_eligible"
